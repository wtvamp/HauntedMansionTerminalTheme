# {{ .Name }} — {{ .Description }}
# Generated by {{ .Generator }}. Do not edit; edit palette/haunted-mansion.yaml.

[colors.primary]
background = "{{ .UI.background.Hex }}"
foreground = "{{ .UI.foreground.Hex }}"

[colors.cursor]
cursor = "{{ .UI.cursor.Hex }}"
text   = "{{ .UI.cursor_text.Hex }}"

[colors.selection]
background = "{{ .UI.selection_background.Hex }}"
text       = "{{ .UI.selection_foreground.Hex }}"

[colors.normal]
{{ range .ANSI }}{{ if lt .Index 8 }}{{ printf "%-7s" .Key }} = "{{ .Hex }}"  # {{ .Label }}
{{ end }}{{ end }}
[colors.bright]
{{ range .ANSI }}{{ if ge .Index 8 }}{{ printf "%-7s" (lower (slice .Key 7)) }} = "{{ .Hex }}"  # {{ .Label }}
{{ end }}{{ end }}
