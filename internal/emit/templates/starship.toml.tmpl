{{- /* Slots bound once; the templates below read as plain TOML. */ -}}
{{- $bg := .UI.background.Hex -}}
{{- $fg := .UI.foreground.Hex -}}
{{- $c0 := (index .ANSI 0).Hex -}}
{{- $c1 := (index .ANSI 1).Hex -}}
{{- $c2 := (index .ANSI 2).Hex -}}
{{- $c3 := (index .ANSI 3).Hex -}}
{{- $c4 := (index .ANSI 4).Hex -}}
{{- $c5 := (index .ANSI 5).Hex -}}
{{- $c6 := (index .ANSI 6).Hex -}}
{{- $c7 := (index .ANSI 7).Hex -}}
{{- $c8 := (index .ANSI 8).Hex -}}
{{- $c9 := (index .ANSI 9).Hex -}}
{{- $c10 := (index .ANSI 10).Hex -}}
{{- $c11 := (index .ANSI 11).Hex -}}
{{- $c12 := (index .ANSI 12).Hex -}}
{{- $c13 := (index .ANSI 13).Hex -}}
{{- $c14 := (index .ANSI 14).Hex -}}
{{- $c15 := (index .ANSI 15).Hex -}}
# {{ .Name }} — generated by {{ .Generator }}. Do not edit; edit palette/haunted-mansion.yaml.
#
# Needs a Nerd Font for the separators and glyphs, which iTerm2 and most
# terminals can be pointed at. Enable with:
#
#   brew install starship
#   # in ~/.zshrc, AFTER oh-my-zsh:
#   export STARSHIP_CONFIG=<repo>/dist/starship/haunted-mansion.toml
#   eval "$(starship init zsh)"

"$schema" = 'https://starship.rs/config-schema.json'

format = """
[](fg:{{ $c4 }})\
$os\
$username\
$hostname\
[](fg:{{ $c4 }} bg:{{ $c12 }})\
$directory\
[](fg:{{ $c12 }} bg:{{ $c5 }})\
$git_branch\
$git_status\
$git_state\
[](fg:{{ $c5 }} bg:{{ $c0 }})\
$golang$nodejs$python$rust$java$dotnet$ruby$php\
$docker_context$kubernetes$aws$azure\
[](fg:{{ $c0 }})\
$fill\
$cmd_duration$jobs$time\
$line_break\
$character"""

right_format = ""
add_newline = true
continuation_prompt = "[  ](fg:{{ $c8 }})"

[fill]
symbol = " "

# ─── who and where ────────────────────────────────────────────────────────────

[os]
disabled = false
style = "fg:{{ $bg }} bg:{{ $c4 }}"
format = '[ $symbol ]($style)'

[os.symbols]
Macos = "󰀵"
Linux = "󰌽"
Windows = "󰍲"

[username]
show_always = false          # only when it is not you: root, or over ssh
style_user = "fg:{{ $bg }} bg:{{ $c4 }}"
style_root = "fg:{{ $c9 }} bg:{{ $c4 }} bold"
format = '[ $user ]($style)'

[hostname]
ssh_only = true              # a local box does not need to tell you its name
style = "fg:{{ $bg }} bg:{{ $c4 }}"
format = '[ $ssh_symbol$hostname ]($style)'
ssh_symbol = "󰢹 "

[directory]
style = "fg:{{ $bg }} bg:{{ $c12 }} bold"
format = "[ $path ]($style)[$read_only]($read_only_style)"
truncation_length = 4
truncate_to_repo = true      # inside a repo, show the path from its root
read_only = " 󰌾"
read_only_style = "fg:{{ $c9 }} bg:{{ $c12 }}"
home_symbol = "󰋜"

[directory.substitutions]
"Documents" = "󰈙"
"Downloads" = "󰇚"
"Music" = "󰝚"
"Pictures" = "󰋩"
"Source" = "󰲋"
"Developer" = "󰲋"

# ─── the crypt: git ───────────────────────────────────────────────────────────

[git_branch]
symbol = ""
style = "fg:{{ $bg }} bg:{{ $c5 }} bold"
format = '[ $symbol $branch ]($style)'
truncation_length = 24
truncation_symbol = "…"

[git_status]
style = "fg:{{ $bg }} bg:{{ $c5 }}"
format = '([$all_status$ahead_behind]($style))'
# Every counter is spelled out: a prompt that hides how much is uncommitted is
# the reason people force-push.
conflicted = "[ ${count}](fg:{{ $c9 }} bg:{{ $c5 }} bold)"
ahead      = "[ ⇡${count}](fg:{{ $bg }} bg:{{ $c5 }})"
behind     = "[ ⇣${count}](fg:{{ $bg }} bg:{{ $c5 }})"
diverged   = "[ ⇕⇡${ahead_count}⇣${behind_count}](fg:{{ $c11 }} bg:{{ $c5 }} bold)"
up_to_date = ""
untracked  = "[ ?${count}](fg:{{ $bg }} bg:{{ $c5 }})"
stashed    = "[ ${count}](fg:{{ $bg }} bg:{{ $c5 }})"
modified   = "[ ${count}](fg:{{ $c11 }} bg:{{ $c5 }} bold)"
staged     = "[ ${count}](fg:{{ $c10 }} bg:{{ $c5 }} bold)"
renamed    = "[ »${count}](fg:{{ $bg }} bg:{{ $c5 }})"
deleted    = "[ ✘${count}](fg:{{ $c9 }} bg:{{ $c5 }} bold)"

[git_state]
style = "fg:{{ $c11 }} bg:{{ $c5 }} bold"
format = '[ $state ($progress_current/$progress_total) ]($style)'
rebase = "󰕍 REBASING"
merge = "󰽜 MERGING"
revert = "󰕌 REVERTING"
cherry_pick = " PICKING"
bisect = " BISECTING"

# ─── what this project is made of ─────────────────────────────────────────────

[golang]
symbol = "󰟓"
style = "fg:{{ $c14 }} bg:{{ $c0 }}"
format = '[ $symbol $version ]($style)'

[nodejs]
symbol = "󰎙"
style = "fg:{{ $c10 }} bg:{{ $c0 }}"
format = '[ $symbol $version ]($style)'

[python]
symbol = "󰌠"
style = "fg:{{ $c11 }} bg:{{ $c0 }}"
format = '[ $symbol $version( $virtualenv) ]($style)'

[rust]
symbol = "󱘗"
style = "fg:{{ $c9 }} bg:{{ $c0 }}"
format = '[ $symbol $version ]($style)'

[java]
symbol = "󰬷"
style = "fg:{{ $c9 }} bg:{{ $c0 }}"
format = '[ $symbol $version ]($style)'

[dotnet]
symbol = "󰪮"
style = "fg:{{ $c13 }} bg:{{ $c0 }}"
format = '[ $symbol $tfm ]($style)'

[ruby]
symbol = "󰴭"
style = "fg:{{ $c9 }} bg:{{ $c0 }}"
format = '[ $symbol $version ]($style)'

[php]
symbol = "󰌟"
style = "fg:{{ $c13 }} bg:{{ $c0 }}"
format = '[ $symbol $version ]($style)'

# ─── where you are pointed ────────────────────────────────────────────────────

[docker_context]
symbol = "󰡨"
style = "fg:{{ $c12 }} bg:{{ $c0 }}"
format = '[ $symbol $context ]($style)'
only_with_files = true

[kubernetes]
disabled = false
symbol = "󱃾"
style = "fg:{{ $c12 }} bg:{{ $c0 }}"
format = '[ $symbol $context( ($namespace)) ]($style)'

[aws]
symbol = "󰸏"
style = "fg:{{ $c11 }} bg:{{ $c0 }}"
format = '[ $symbol $profile( ($region)) ]($style)'

[azure]
disabled = false
symbol = "󰠅"
style = "fg:{{ $c12 }} bg:{{ $c0 }}"
format = '[ $symbol $subscription ]($style)'

# ─── the right-hand chill ─────────────────────────────────────────────────────

[cmd_duration]
min_time = 2000              # anything under two seconds is not worth reporting
style = "fg:{{ $c11 }}"
format = '[ 󰔟 $duration ]($style)'
show_milliseconds = false

[jobs]
symbol = "󰑮"
style = "fg:{{ $c13 }}"
format = '[ $symbol $number ]($style)'
number_threshold = 1

[time]
disabled = false
time_format = "%H:%M"
style = "fg:{{ $c8 }}"
format = '[ 󰥔 $time ]($style)'

# ─── the tombstone you type after ─────────────────────────────────────────────

[character]
success_symbol = "[†](bold fg:{{ $c13 }})"
error_symbol = "[†](bold fg:{{ $c9 }})"
vimcmd_symbol = "[⚰](bold fg:{{ $c10 }})"

[line_break]
disabled = false
