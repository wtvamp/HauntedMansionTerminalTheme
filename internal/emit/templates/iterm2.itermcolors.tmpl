<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- {{ .Name }} — generated by {{ .Generator }}. Edit palette/haunted-mansion.yaml. -->
<plist version="1.0">
<dict>
{{ range .ANSI }}	<key>Ansi {{ .Index }} Color</key>
	<dict>
		<key>Color Space</key>
		<string>sRGB</string>
		<key>Red Component</key>
		<real>{{ printf "%.10f" .R }}</real>
		<key>Green Component</key>
		<real>{{ printf "%.10f" .G }}</real>
		<key>Blue Component</key>
		<real>{{ printf "%.10f" .B }}</real>
		<key>Alpha Component</key>
		<real>1</real>
	</dict>
{{ end }}{{ range $e := .ITermExtras }}	<key>{{ $e.Label }}</key>
	<dict>
		<key>Color Space</key>
		<string>sRGB</string>
		<key>Red Component</key>
		<real>{{ printf "%.10f" $e.R }}</real>
		<key>Green Component</key>
		<real>{{ printf "%.10f" $e.G }}</real>
		<key>Blue Component</key>
		<real>{{ printf "%.10f" $e.B }}</real>
		<key>Alpha Component</key>
		<real>1</real>
	</dict>
{{ end }}</dict>
</plist>
