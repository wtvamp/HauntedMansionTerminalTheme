{{- $bg := .UI.background.Hex -}}
{{- $c1 := (index .ANSI 1).Hex -}}
{{- $c2 := (index .ANSI 2).Hex -}}
{{- $c5 := (index .ANSI 5).Hex -}}
{{- $c8 := (index .ANSI 8).Hex -}}
{{- $c11 := (index .ANSI 11).Hex -}}
{{- $c14 := (index .ANSI 14).Hex -}}
{{- $c15 := (index .ANSI 15).Hex -}}
# {{ .Name }} — generated by {{ .Generator }}. Edit palette/haunted-mansion.yaml.
#
# Add to ~/.gitconfig:
#   [include]
#       path = <repo>/dist/git/haunted-mansion.gitconfig

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true
	syntax-theme = haunted-mansion

	# Added and removed are deliberately the theme's green and red rather than
	# anything more atmospheric: a diff is the one place where getting the
	# direction wrong costs real work.
	plus-style = syntax "{{ $c2 }}22"
	plus-emph-style = syntax "{{ $c2 }}44"
	minus-style = syntax "{{ $c1 }}22"
	minus-emph-style = syntax "{{ $c1 }}44"

	line-numbers-minus-style = "{{ $c1 }}"
	line-numbers-plus-style = "{{ $c2 }}"
	line-numbers-zero-style = "{{ $c8 }}"
	line-numbers-left-style = "{{ $c8 }}"
	line-numbers-right-style = "{{ $c8 }}"

	file-style = bold "{{ $c14 }}"
	file-decoration-style = "{{ $c5 }}" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "{{ $c8 }}" box
	hunk-header-file-style = "{{ $c15 }}"
	hunk-header-line-number-style = bold "{{ $c11 }}"

	blame-palette = "{{ $bg }}" "{{ $c8 }}"
	merge-conflict-begin-symbol = "▼"
	merge-conflict-end-symbol = "▲"
	merge-conflict-ours-diff-header-style = bold "{{ $c11 }}"
	merge-conflict-theirs-diff-header-style = bold "{{ $c14 }}"

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default
