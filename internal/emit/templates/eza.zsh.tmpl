#
# eza colours, as ANSI slot numbers rather than hex so they follow whatever
# theme the terminal has loaded — the same reasoning as the portraits.
#
# Slot map: {{ range .ANSI }}{{ .Index }}={{ .Key }} {{ end }}

# di/ex/ln… file kinds · ur/uw/ux… permissions (read parchment, write brass,
# execute ectoplasm) · uu/gu… ownership · ga/gm/gd… git status in the listing ·
# then per-extension: source, docs, media, archives, and the unloved.
typeset -g EZA_COLORS="\
di=1;{{ (index .ANSI 12).Ansi }}:\
ex=1;{{ (index .ANSI 10).Ansi }}:\
ln={{ (index .ANSI 14).Ansi }}:\
or=1;{{ (index .ANSI 9).Ansi }}:\
