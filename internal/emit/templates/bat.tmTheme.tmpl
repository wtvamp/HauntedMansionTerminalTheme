{{- $bg := .UI.background.Hex -}}
{{- $fg := .UI.foreground.Hex -}}
{{- $sel := .UI.selection_background.Hex -}}
{{- $c1 := (index .ANSI 1).Hex -}}
{{- $c2 := (index .ANSI 2).Hex -}}
{{- $c3 := (index .ANSI 3).Hex -}}
{{- $c4 := (index .ANSI 4).Hex -}}
{{- $c5 := (index .ANSI 5).Hex -}}
{{- $c6 := (index .ANSI 6).Hex -}}
{{- $c7 := (index .ANSI 7).Hex -}}
{{- $c8 := (index .ANSI 8).Hex -}}
{{- $c9 := (index .ANSI 9).Hex -}}
{{- $c10 := (index .ANSI 10).Hex -}}
{{- $c11 := (index .ANSI 11).Hex -}}
{{- $c12 := (index .ANSI 12).Hex -}}
{{- $c13 := (index .ANSI 13).Hex -}}
{{- $c14 := (index .ANSI 14).Hex -}}
{{- $c15 := (index .ANSI 15).Hex -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- {{ .Name }} — generated by {{ .Generator }}. Edit palette/haunted-mansion.yaml.
     Install: copy to "$(bat --config-dir)/themes/" then run `bat cache --build`. -->
<plist version="1.0">
<dict>
	<key>name</key><string>{{ .Name }}</string>
	<key>semanticClass</key><string>theme.dark.haunted_mansion</string>
	<key>uuid</key><string>7b3e1a52-9d4c-4f18-8a6b-{{ .UI.background.Bare }}</string>
	<key>colorSpaceName</key><string>sRGB</string>
	<key>settings</key>
	<array>
		<dict>
			<key>settings</key>
			<dict>
				<key>background</key><string>{{ $bg }}</string>
				<key>foreground</key><string>{{ $fg }}</string>
				<key>caret</key><string>{{ .UI.cursor.Hex }}</string>
				<key>lineHighlight</key><string>{{ $sel }}</string>
				<key>selection</key><string>{{ $sel }}</string>
				<key>gutterForeground</key><string>{{ $c8 }}</string>
				<key>invisibles</key><string>{{ $c8 }}</string>
			</dict>
		</dict>
{{- range $s := (list
	(dict "n" "Comment" "s" "comment" "c" $c8 "f" "italic")
	(dict "n" "String" "s" "string" "c" $c2 "f" "")
	(dict "n" "Escape in string" "s" "constant.character.escape" "c" $c14 "f" "")
	(dict "n" "Number" "s" "constant.numeric" "c" $c13 "f" "")
	(dict "n" "Built-in constant" "s" "constant.language" "c" $c13 "f" "")
	(dict "n" "Keyword" "s" "keyword, storage.type, storage.modifier" "c" $c5 "f" "")
	(dict "n" "Operator" "s" "keyword.operator" "c" $c6 "f" "")
	(dict "n" "Function name" "s" "entity.name.function, support.function" "c" $c11 "f" "")
	(dict "n" "Function argument" "s" "variable.parameter" "c" $c7 "f" "italic")
	(dict "n" "Type" "s" "entity.name.type, entity.name.class, support.type, support.class" "c" $c14 "f" "")
	(dict "n" "Variable" "s" "variable, variable.other" "c" $fg "f" "")
	(dict "n" "Member" "s" "variable.other.member, meta.property" "c" $c12 "f" "")
	(dict "n" "Tag" "s" "entity.name.tag" "c" $c5 "f" "")
	(dict "n" "Tag attribute" "s" "entity.other.attribute-name" "c" $c11 "f" "")
	(dict "n" "Punctuation" "s" "punctuation" "c" $c7 "f" "")
	(dict "n" "Invalid" "s" "invalid" "c" $c9 "f" "bold")
	(dict "n" "Deprecated" "s" "invalid.deprecated" "c" $c1 "f" "underline")
	(dict "n" "Heading" "s" "markup.heading" "c" $c15 "f" "bold")
	(dict "n" "Link" "s" "markup.underline.link, string.other.link" "c" $c14 "f" "underline")
	(dict "n" "Bold" "s" "markup.bold" "c" $c15 "f" "bold")
	(dict "n" "Italic" "s" "markup.italic" "c" $c15 "f" "italic")
	(dict "n" "Raw" "s" "markup.raw" "c" $c3 "f" "")
	(dict "n" "Quote" "s" "markup.quote" "c" $c8 "f" "italic")
	(dict "n" "List" "s" "markup.list" "c" $c12 "f" "")
	(dict "n" "Diff added" "s" "markup.inserted" "c" $c10 "f" "")
	(dict "n" "Diff removed" "s" "markup.deleted" "c" $c9 "f" "")
	(dict "n" "Diff changed" "s" "markup.changed" "c" $c11 "f" "")
) }}
		<dict>
			<key>name</key><string>{{ index $s "n" }}</string>
			<key>scope</key><string>{{ index $s "s" }}</string>
			<key>settings</key>
			<dict>
				<key>foreground</key><string>{{ index $s "c" }}</string>
{{- if index $s "f" }}
				<key>fontStyle</key><string>{{ index $s "f" }}</string>
{{- end }}
			</dict>
		</dict>
{{- end }}
	</array>
</dict>
</plist>
