# {{ .Name }} — {{ .Description }}
# Generated by {{ .Generator }}. Do not edit; edit palette/haunted-mansion.yaml.
# Drop into ~/.config/wezterm/colors/ and set color_scheme = "{{ .Name }}".

[colors]
background = "{{ .UI.background.Hex }}"
foreground = "{{ .UI.foreground.Hex }}"
cursor_bg = "{{ .UI.cursor.Hex }}"
cursor_fg = "{{ .UI.cursor_text.Hex }}"
cursor_border = "{{ .UI.cursor.Hex }}"
selection_bg = "{{ .UI.selection_background.Hex }}"
selection_fg = "{{ .UI.selection_foreground.Hex }}"
ansi = [{{ range .ANSI }}{{ if lt .Index 8 }}"{{ .Hex }}",{{ end }}{{ end }}]
brights = [{{ range .ANSI }}{{ if ge .Index 8 }}"{{ .Hex }}",{{ end }}{{ end }}]

[metadata]
name = "{{ .Name }}"
author = "{{ .Author }}"
