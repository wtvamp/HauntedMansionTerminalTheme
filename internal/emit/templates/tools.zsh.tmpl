{{- $bg := .UI.background.Hex -}}
{{- $fg := .UI.foreground.Hex -}}
{{- $c1 := (index .ANSI 1).Hex -}}
{{- $c5 := (index .ANSI 5).Hex -}}
{{- $c8 := (index .ANSI 8).Hex -}}
{{- $c11 := (index .ANSI 11).Hex -}}
{{- $c13 := (index .ANSI 13).Hex -}}
{{- $c14 := (index .ANSI 14).Hex -}}
{{- $c15 := (index .ANSI 15).Hex -}}
# {{ .Name }} — generated by {{ .Generator }}. Do not edit; edit palette/haunted-mansion.yaml.
#
# Themes the command-line tools that are actually installed. Every block is
# guarded, so this file is safe to source whether or not you have the tool.

# ── bat ───────────────────────────────────────────────────────────────────────
# The theme registers under its FILENAME, not the name inside the plist.
if (( $+commands[bat] )); then
  export BAT_THEME="haunted-mansion"
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
  export MANROFFOPT="-c"
fi

# ── eza ───────────────────────────────────────────────────────────────────────
[[ -r ${0:A:h}/_eza.zsh ]] && source ${0:A:h}/_eza.zsh

# ── fzf ───────────────────────────────────────────────────────────────────────
if (( $+commands[fzf] )); then
  export FZF_DEFAULT_OPTS="\
--height=60% --layout=reverse --border=rounded --info=inline \
--prompt='† ' --pointer='⚰' --marker='✦' \
--color=bg+:{{ .UI.selection_background.Hex }},bg:-1,spinner:{{ $c13 }},hl:{{ $c11 }} \
--color=fg:{{ $fg }},header:{{ $c5 }},info:{{ $c8 }},pointer:{{ $c13 }} \
--color=marker:{{ $c14 }},fg+:{{ $c15 }},prompt:{{ $c13 }},hl+:{{ $c11 }} \
--color=border:{{ $c5 }}"
  (( $+commands[fd] )) && export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
  (( $+commands[fd] )) && export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  (( $+commands[bat] )) && export FZF_CTRL_T_OPTS="--preview 'bat -n --color=always {}'"
fi

# ── starship ──────────────────────────────────────────────────────────────────
# Must come after oh-my-zsh, which sets its own PROMPT.
if (( $+commands[starship] )); then
  export STARSHIP_CONFIG="${HM_ROOT:-${0:A:h:h:h}}/dist/starship/haunted-mansion.toml"
  eval "$(starship init zsh)"
fi

# ── less ──────────────────────────────────────────────────────────────────────
export LESS='-R --use-color'
