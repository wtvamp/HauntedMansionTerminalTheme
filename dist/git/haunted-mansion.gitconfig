# Haunted Mansion — generated by conjure. Edit palette/haunted-mansion.yaml.
#
# Add to ~/.gitconfig:
#   [include]
#       path = <repo>/dist/git/haunted-mansion.gitconfig

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true
	syntax-theme = haunted-mansion

	# Added and removed are deliberately the theme's green and red rather than
	# anything more atmospheric: a diff is the one place where getting the
	# direction wrong costs real work.
	#
	# These are the hue mixed most of the way into the background, not the hue
	# itself. delta has no alpha channel and silently truncates an 8-digit hex
	# to six, so "#5FBE8C22" paints the whole line in full-saturation green.
	plus-style = syntax "#1D2E2B"
	plus-emph-style = syntax "#2B4D40"
	minus-style = syntax "#2D1B21"
	minus-emph-style = syntax "#4C252B"

	line-numbers-minus-style = "#C1484F"
	line-numbers-plus-style = "#5FBE8C"
	line-numbers-zero-style = "#363D4C"
	line-numbers-left-style = "#363D4C"
	line-numbers-right-style = "#363D4C"

	file-style = bold "#96D6EA"
	file-decoration-style = "#8663B4" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#363D4C" box
	hunk-header-file-style = "#E6ECF5"
	hunk-header-line-number-style = bold "#EBC66A"

	blame-palette = "#111319" "#363D4C"
	merge-conflict-begin-symbol = "▼"
	merge-conflict-end-symbol = "▲"
	merge-conflict-ours-diff-header-style = bold "#EBC66A"
	merge-conflict-theirs-diff-header-style = bold "#96D6EA"

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default
